citHeader("To cite metaMultiverse in publications use:")

# `meta` is supplied by readCitationFile() from DESCRIPTION, whether or not
# the package is installed. Authors@R holds R code, so it is evaluated rather
# than passed to as.person(), which would split it into meaningless pieces.
year <- sub("-.*", "", meta$Date)
if (is.null(year) || length(year) == 0 || !nzchar(year)) year <- format(Sys.Date(), "%Y")
authors <- eval(parse(text = meta$`Authors@R`))
authors <- authors[vapply(authors, function(p) "aut" %in% p$role, logical(1))]

bibentry(
  bibtype = "Manual",
  title   = "{metaMultiverse}: Principled Multiverse Meta-Analysis in {R}",
  author  = authors,
  year    = year,
  note    = paste("R package version", meta$Version),
  url     = "https://github.com/cyplessen/metaMultiverse",
  doi     = "10.5281/zenodo.22705834",
  textVersion = paste0(
    "Plessen, C. Y. (", year, "). ",
    "metaMultiverse: Principled Multiverse Meta-Analysis in R. ",
    "R package version ", meta$Version, ". ",
    "https://doi.org/10.5281/zenodo.22705834"
  )
)
